<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Id="CuajonePpeMonitor"
           Name="Cuajone PPE Monitor"
           Manufacturer="Cuajone PPE Monitor Project"
           Language="1033"
           Version="$(var.MsiVersion)"
           UpgradeCode="88A886C2-8F6D-4669-B6FB-7DFC1E7B0397"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="Cuajone PPE Monitor $(var.AppVersion) x64"
                        Manufacturer="Cuajone PPE Monitor Project" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Cuajone PPE Monitor is already installed. Uninstall it before installing this older package."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="COMPUTE_MODE" Value="auto" Secure="yes">
      <RegistrySearch Id="PreviousComputeMode"
                      Root="HKLM"
                      Key="SOFTWARE\Cuajone PPE Monitor"
                      Name="ComputeMode"
                      Type="raw"
                      Bitness="always64" />
    </Property>
    <Property Id="CUDA_READY" Value="0" Secure="yes" />
    <Property Id="NVIDIA_STATUS" Value="not_probed" Secure="yes" />
    <Property Id="ARPCOMMENTS" Value="$(var.ArpComments)" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jeanpaulandradeleiva-crypto/CAMARAS-IP-CUAJONE/issues" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jeanpaulandradeleiva-crypto/CAMARAS-IP-CUAJONE" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/jeanpaulandradeleiva-crypto/CAMARAS-IP-CUAJONE/releases" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Icon Id="ProductIcon" SourceFile="$(var.StageDir)\CuajonePPEMonitor.ico" />

    <Launch Condition="Installed OR COMPUTE_MODE=&quot;auto&quot; OR COMPUTE_MODE=&quot;cuda&quot; OR COMPUTE_MODE=&quot;cpu&quot;"
            Message="COMPUTE_MODE must be auto, cuda, or cpu." />

    <Binary Id="HardwareProbeCA" SourceFile="$(var.HardwareProbeCA)" />
    <CustomAction Id="DetectComputeHardware"
                  BinaryRef="HardwareProbeCA"
                  DllEntry="DetectComputeHardware"
                  Execute="immediate"
                  Return="check" />
    <CustomAction Id="BlockUnavailableCuda"
                  Error="GPU (CUDA) mode requires a usable NVIDIA adapter, SM 7.5+, and CUDA Driver API 12.9+. Use COMPUTE_MODE=auto or COMPUTE_MODE=cpu; the MSI never installs display drivers." />

    <InstallUISequence>
      <Custom Action="DetectComputeHardware"
              After="CostFinalize"
              Condition="NOT Installed" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="DetectComputeHardware"
              Before="LaunchConditions"
              Condition="NOT Installed" />
      <Custom Action="BlockUnavailableCuda"
              After="DetectComputeHardware"
              Condition="NOT Installed AND COMPUTE_MODE=&quot;cuda&quot; AND CUDA_READY&lt;&gt;&quot;1&quot;" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <UI Id="CuajoneComputeUI">
      <Dialog Id="ComputeDlg" Width="370" Height="270" Title="Cuajone PPE Monitor - Compute">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
          <?if $(var.HasModels)=1 ?>
          <Publish Event="NewDialog" Value="CustomizeDlg" />
          <?else?>
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
          <?endif?>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Title" Type="Text" X="15" Y="6" Width="260" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose the compute mode" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="28" Transparent="yes" NoPrefix="yes"
                 Text="Auto prefers a ready NVIDIA GPU and otherwise uses CPU. The installer never installs or changes display drivers." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="373" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="373" Height="0" />
        <Control Id="ProbeStatus" Type="Text" X="25" Y="58" Width="320" Height="18" NoPrefix="yes"
                 Text="NVIDIA/CUDA status: [NVIDIA_STATUS]" />
        <Control Id="ComputeModeSelection" Type="RadioButtonGroup" X="25" Y="84" Width="320" Height="66"
                 Property="COMPUTE_MODE">
          <RadioButtonGroup Property="COMPUTE_MODE">
            <RadioButton Value="auto" X="0" Y="0" Width="320" Height="17" Text="Auto (recommended)" />
            <RadioButton Value="cuda" X="0" Y="22" Width="320" Height="17" Text="GPU (CUDA)" />
            <RadioButton Value="cpu" X="0" Y="44" Width="320" Height="17" Text="CPU" />
          </RadioButtonGroup>
        </Control>
        <Control Id="UnavailableWarning" Type="Text" X="25" Y="158" Width="320" Height="38" NoPrefix="yes"
                 ShowCondition="CUDA_READY&lt;&gt;&quot;1&quot;"
                 HideCondition="CUDA_READY=&quot;1&quot;"
                  Text="GPU requires NVIDIA SM 7.5+ and CUDA Driver API 12.9+. Choose Auto or CPU when GPU is unavailable; this installer never changes drivers." />
      </Dialog>
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ComputeDlg"
               Order="5" Condition="NOT Installed" />
      <?if $(var.HasModels)=1 ?>
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="ComputeDlg" Order="1" />
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg"
               Order="3" Condition="NOT Installed" />
      <?else?>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ComputeDlg"
               Order="3" Condition="NOT Installed" />
      <?endif?>
    </UI>

    <Feature Id="MainFeature" Title="Cuajone PPE Monitor" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentGroupRef Id="RuntimeDataDirectories" />
    </Feature>
    <?if $(var.HasModels)=1 ?>
    <Feature Id="ModelsFeature" Title="AI Models (ONNX)" Description="Bundled ONNX models for PPE and pose detection. Uncheck to skip; the launcher can browse to external files." Level="1">
      <ComponentGroupRef Id="ModelComponents" />
    </Feature>
    <?endif?>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Cuajone PPE Monitor" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="APPLICATIONDATAFOLDER" Name="Cuajone PPE Monitor">
        <Directory Id="RUNTIMEFOLDER" Name="runtime">
          <Directory Id="MODELSFOLDER" Name="models" />
          <Directory Id="CONFIGFOLDER" Name="config" />
          <Directory Id="OUTPUTFOLDER" Name="output" />
          <Directory Id="LOGSFOLDER" Name="logs" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuAppFolder" Name="Cuajone PPE Monitor" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="RuntimeDataDirectories">
      <Component Id="RuntimeModelsDirectory" Directory="MODELSFOLDER" Guid="D35B10E0-97B1-4CB4-A638-8BD836FF77F5">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeConfigDirectory" Directory="CONFIGFOLDER" Guid="0CE24DFA-B744-43D4-999C-4CB3886BE0A5">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeOutputDirectory" Directory="OUTPUTFOLDER" Guid="9D3B7F4F-CB4F-4E95-AF35-7DA01CA06097">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeLogsDirectory" Directory="LOGSFOLDER" Guid="8EF4EA77-F8B0-4AAE-A686-175C83C066D3">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericRead="yes" GenericWrite="yes" GenericExecute="yes"
                             CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes"
                             ReadPermission="yes" Synchronize="yes" Traverse="yes" />
        </CreateFolder>
      </Component>
      <Component Id="RuntimeComputeMode" Directory="INSTALLFOLDER" Guid="599B1C29-1D13-46EF-B458-1F778E61A813">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Cuajone PPE Monitor"
                       Name="ComputeMode"
                       Type="string"
                       Value="[COMPUTE_MODE]"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
