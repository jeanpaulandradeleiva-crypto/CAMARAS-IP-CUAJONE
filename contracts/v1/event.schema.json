{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuajone.example/contracts/v1/event.schema.json",
  "title": "Cuajone safety event CloudEvents 1.0 envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "dataschema", "subject", "contractversion", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^evt-[A-Za-z0-9._:-]+$"},
    "source": {"type": "string", "pattern": "^urn:cuajone:camera:[A-Za-z0-9._:-]+$"},
    "type": {"enum": ["com.cuajone.safety.ppe.violation.v1", "com.cuajone.safety.fall.possible.v1"]},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "https://cuajone.example/contracts/v1/event.schema.json"},
    "subject": {"type": "string", "pattern": "^track/[1-9][0-9]*$"},
    "contractversion": {"const": "1.0.0"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "frame_id", "monotonic_timestamp_ms", "track_id", "status", "confidence", "evidence"],
      "properties": {
        "contract_version": {"const": "1.0.0"},
        "frame_id": {"type": "integer", "minimum": 0},
        "monotonic_timestamp_ms": {"type": "integer", "minimum": 0},
        "track_id": {"type": "integer", "minimum": 1},
        "status": {"enum": ["EPP Completo", "Falta Chaleco", "Falta Casco", "Sin Casco y Chaleco", "En evaluación"]},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Canonical float32 confidence rounded to at most six decimal places.",
          "x-canonical-decimal-digits": 6
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "sha256"],
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^(urn:|https://|file:)",
                "not": {"pattern": "^[Rr][Tt][Ss]?[Pp]://|@|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]"}
              },
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
