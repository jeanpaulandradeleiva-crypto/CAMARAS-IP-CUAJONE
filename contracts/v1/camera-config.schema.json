{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuajone.example/contracts/v1/camera-config.schema.json",
  "title": "Cuajone authorized source configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "camera_id", "source"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "camera_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {"enum": ["image", "video"]},
            "path": {"type": "string", "minLength": 1, "not": {"pattern": "^[Rr][Tt][Ss]?[Pp]://|@"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "device_index"],
          "properties": {
            "kind": {"const": "webcam"},
            "device_index": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "environment_variable"],
          "properties": {
            "kind": {"const": "rtsp"},
            "environment_variable": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$"}
          }
        }
      ]
    }
  }
}
