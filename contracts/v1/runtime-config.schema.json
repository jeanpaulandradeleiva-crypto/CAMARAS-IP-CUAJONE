{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuajone.example/contracts/v1/runtime-config.schema.json",
  "title": "Cuajone runtime configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "analytics", "thresholds", "tracker", "ppe", "fall"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "backend"],
      "properties": {
        "mode": {"enum": ["ppe-only", "ppe-fall"]},
        "backend": {"enum": ["experimental", "native"]}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ppe_confidence", "pose_confidence", "nms_iou", "maximum_detections"],
      "properties": {
        "ppe_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "pose_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "nms_iou": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_detections": {"type": "integer", "minimum": 1, "maximum": 30000}
      }
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "high_confidence_threshold", "low_confidence_threshold", "match_threshold", "maximum_age", "maximum_tracks", "frame_rate"],
      "properties": {
        "profile": {"const": "byte-track-eigen"},
        "high_confidence_threshold": {"type": "number", "exclusiveMinimum": 0.2, "maximum": 1},
        "low_confidence_threshold": {"const": 0.1},
        "match_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_age": {"type": "integer", "minimum": 1},
        "maximum_tracks": {"type": "integer", "minimum": 1},
        "frame_rate": {"type": "integer", "minimum": 1}
      }
    },
    "ppe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "minimum_samples", "present_ratio", "alert_cooldown_ms", "track_ttl_ms"],
      "properties": {
        "window": {"type": "integer", "minimum": 1},
        "minimum_samples": {"type": "integer", "minimum": 1},
        "present_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "alert_cooldown_ms": {"type": "integer", "minimum": 0},
        "track_ttl_ms": {"type": "integer", "minimum": 0}
      }
    },
    "fall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirm_frames", "reset_frames", "alert_cooldown_ms", "track_ttl_ms", "aspect_ratio", "torso_angle_degrees", "descent_ratio", "near_floor_ratio"],
      "properties": {
        "confirm_frames": {"type": "integer", "minimum": 1},
        "reset_frames": {"type": "integer", "minimum": 1},
        "alert_cooldown_ms": {"type": "integer", "minimum": 0},
        "track_ttl_ms": {"type": "integer", "minimum": 0},
        "aspect_ratio": {"type": "number", "exclusiveMinimum": 0},
        "torso_angle_degrees": {"type": "number", "minimum": 0, "maximum": 90},
        "descent_ratio": {"type": "number", "minimum": 0},
        "near_floor_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
