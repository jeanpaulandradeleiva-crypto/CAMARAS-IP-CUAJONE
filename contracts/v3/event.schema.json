{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuajone.example/contracts/v3/event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "dataschema", "subject", "contractversion", "data"],
  "properties": {
    "specversion": {"const": "1.0"}, "id": {"type": "string"}, "source": {"type": "string"},
    "type": {"const": "com.cuajone.safety.ppe.violation.v3"}, "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"}, "dataschema": {"const": "https://cuajone.example/contracts/v3/event.schema.json"},
    "subject": {"type": "string"}, "contractversion": {"const": "3.0.0"},
    "data": {"type": "object", "additionalProperties": false, "required": ["contract_version", "frame_id", "monotonic_timestamp_ms", "track_id", "status", "confidence", "ppe", "evidence"], "properties": {"contract_version": {"const": "3.0.0"}, "frame_id": {"type": "integer", "minimum": 0}, "monotonic_timestamp_ms": {"type": "integer", "minimum": 0}, "track_id": {"type": "integer", "minimum": 1}, "status": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "ppe": {"$ref": "#/$defs/ppe"}, "evidence": {"type": "array"}}}
  },
  "$defs": {
    "box": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "semantic": {"enum": ["gloves", "safety_boots", "vest", "respirator", "hearing_protection", "hard_hat", "eye_protection"]},
    "ppe_item": {"type": "object", "additionalProperties": false, "required": ["semantic", "label", "enabled", "wear_state", "reason", "confidence", "detection"], "properties": {"semantic": {"$ref": "#/$defs/semantic"}, "label": {"type": "string"}, "enabled": {"type": "boolean"}, "wear_state": {"enum": ["PRESENTE_CORRECTAMENTE", "PRESENTE_INCORRECTAMENTE", "AUSENTE", "NO_VERIFICABLE"]}, "reason": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "detection": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["box", "confidence"], "properties": {"box": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}]}}},
    "ppe": {"type": "object", "additionalProperties": false, "required": ["state", "samples", "items"], "properties": {"state": {"enum": ["evaluating", "compliant", "noncompliant"]}, "samples": {"type": "integer", "minimum": 0}, "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/ppe_item"}}}}
  }
}
