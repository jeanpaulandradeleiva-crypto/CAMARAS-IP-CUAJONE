{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuajone.example/contracts/v3/frame-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_id", "frame_id", "monotonic_timestamp_ms", "observed_at", "frame", "people", "events"],
  "properties": {
    "contract_version": {"const": "3.0.0"},
    "source_id": {"type": "string", "minLength": 1},
    "frame_id": {"type": "integer", "minimum": 0},
    "monotonic_timestamp_ms": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "frame": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "events": {"type": "array", "items": {"type": "string"}},
    "people": {"type": "array", "items": {"$ref": "#/$defs/person"}}
  },
  "$defs": {
    "box": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "keypoint": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false},
    "semantic": {"enum": ["gloves", "safety_boots", "vest", "respirator", "hearing_protection", "hard_hat", "eye_protection"]},
    "ppe_item": {"type": "object", "additionalProperties": false, "required": ["semantic", "label", "enabled", "wear_state", "reason", "confidence", "detection"], "properties": {"semantic": {"$ref": "#/$defs/semantic"}, "label": {"type": "string"}, "enabled": {"type": "boolean"}, "wear_state": {"enum": ["PRESENTE_CORRECTAMENTE", "PRESENTE_INCORRECTAMENTE", "AUSENTE", "NO_VERIFICABLE"]}, "reason": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "detection": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["box", "confidence"], "properties": {"box": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}]}}},
    "ppe": {"type": "object", "additionalProperties": false, "required": ["state", "samples", "items"], "properties": {"state": {"enum": ["evaluating", "compliant", "noncompliant"]}, "samples": {"type": "integer", "minimum": 0}, "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/ppe_item"}}}},
    "person": {"type": "object", "additionalProperties": false, "required": ["track_id", "box", "confidence", "ppe_visibility_sufficient", "ppe", "fall_active", "keypoints"], "properties": {"track_id": {"type": "integer", "minimum": 1}, "box": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "ppe_visibility_sufficient": {"type": "boolean"}, "ppe": {"$ref": "#/$defs/ppe"}, "fall_active": {"type": "boolean"}, "keypoints": {"type": "array", "items": {"$ref": "#/$defs/keypoint"}}}}
  }
}
