{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cuajone.example/contracts/v2/frame-result.schema.json",
  "title": "Cuajone canonical frame result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "source_id", "frame_id", "monotonic_timestamp_ms", "observed_at", "frame", "people", "events"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128, "not": {"pattern": "[Rr][Tt][Ss][Pp][Ss]?://|@|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]"}},
    "frame_id": {"type": "integer", "minimum": 0},
    "monotonic_timestamp_ms": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "people": {"type": "array", "items": {"$ref": "#/$defs/person"}},
    "events": {"type": "array", "items": {"type": "string", "pattern": "^evt-[A-Za-z0-9._:-]+$"}}
  },
  "$defs": {
    "box": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "keypoint": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number", "minimum": 0, "maximum": 1}],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "semantic": {"enum": ["gloves", "safety_boots", "vest", "respirator", "hearing_protection", "hard_hat", "eye_protection"]},
    "ppe_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "label", "required", "present", "ratio", "confidence", "detection"],
      "properties": {
        "semantic": {"$ref": "#/$defs/semantic"},
        "label": {"type": "string", "minLength": 1},
        "required": {"const": true},
        "present": {"type": "boolean"},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        ,"detection": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["box", "confidence"], "properties": {"box": {"$ref": "#/$defs/box"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}
          ]
        }
      }
    },
    "ppe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "samples", "required", "present", "missing", "items"],
      "properties": {
        "state": {"enum": ["evaluating", "compliant", "noncompliant"]},
        "samples": {"type": "integer", "minimum": 0},
        "required": {"type": "array", "prefixItems": [{"const": "gloves"}, {"const": "safety_boots"}, {"const": "vest"}, {"const": "respirator"}, {"const": "hearing_protection"}, {"const": "hard_hat"}, {"const": "eye_protection"}], "items": false, "minItems": 7, "maxItems": 7},
        "present": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semantic"}},
        "missing": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/semantic"}},
        "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/ppe_item"}}
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "box", "confidence", "ppe_visibility_sufficient", "ppe", "fall_active", "keypoints"],
      "properties": {
        "track_id": {"type": "integer", "minimum": 1},
        "box": {"$ref": "#/$defs/box"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "ppe_visibility_sufficient": {"type": "boolean"},
        "ppe": {"$ref": "#/$defs/ppe"},
        "fall_active": {"type": "boolean"},
        "keypoints": {"type": "array", "items": {"$ref": "#/$defs/keypoint"}}
      }
    }
  }
}
