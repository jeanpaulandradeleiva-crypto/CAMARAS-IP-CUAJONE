# ============================================================
# CÁMARA Y MODELOS
# ============================================================
CAMERA_ID=CAM_CUAJONE_01
RTSP_URL=rtsp://USUARIO:CONTRASENA@IP/axis-media/media.amp
PPE_MODEL_PATH=best_ppe.pt
POSE_MODEL_PATH=yolo26s-pose.pt

# 0 = primera GPU NVIDIA; cpu = usar procesador.
YOLO_DEVICE=0
YOLO_TRACKER=bytetrack.yaml
USE_FP16=1

# ============================================================
# SALIDA E INTERFAZ
# ============================================================
# Vacío o . = carpeta del programa. También admite una ruta absoluta.
OUTPUT_DIR=.
SHOW_WINDOW=1
SHOW_TEMPORARY_TRACK_ID=0
EXCEL_EXPORT_EVERY_EVENTS=10

# ============================================================
# INFERENCIA
# ============================================================
POSE_IMGSZ=640
PPE_IMGSZ=640
POSE_CONF=0.35
PPE_CONF=0.30
IOU_THRESHOLD=0.45

# ============================================================
# EPP
# ============================================================
EPP_WINDOW=20
EPP_MIN_SAMPLES=12
EPP_PRESENT_RATIO=0.35
EPP_ALERT_COOLDOWN_S=60

# ============================================================
# CAÍDAS
# ============================================================
FALL_CONFIRM_FRAMES=12
FALL_RESET_FRAMES=20
FALL_ALERT_COOLDOWN_S=120
FALL_ASPECT_RATIO=1.05
FALL_TORSO_ANGLE_DEG=55
FALL_DESCENT_RATIO=0.12
FALL_NEAR_FLOOR_RATIO=0.65

# ============================================================
# STREAM Y SEGUIMIENTO TEMPORAL
# ============================================================
TRACK_TTL_S=5
RECONNECT_DELAY_S=5
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=3000
