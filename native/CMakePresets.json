{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 native runtime",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../.tools/native/build/presets/windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "TENSORRT_ROOT": "$env{TENSORRT_ROOT}",
        "ONNXRUNTIME_ROOT": "$env{ONNXRUNTIME_ROOT}",
        "CUDA_RUNTIME_ROOT": "$env{CUDA_RUNTIME_ROOT}",
        "CUDA_COMPILER_HEADERS_ROOT": "$env{CUDA_COMPILER_HEADERS_ROOT}",
        "CUDA_CCCL_HEADERS_ROOT": "$env{CUDA_CCCL_HEADERS_ROOT}",
        "OpenCV_DIR": "$env{OpenCV_DIR}"
      }
    },
    {
      "name": "cpu-tests",
      "displayName": "CPU tests without CUDA or TensorRT",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../.tools/native/build/presets/cpu-tests",
      "cacheVariables": {
        "CUAJONE_BUILD_RUNTIME": "ON",
        "CUAJONE_ENABLE_TENSORRT": "OFF",
        "CUAJONE_BUILD_TESTS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "ONNXRUNTIME_ROOT": "$env{ONNXRUNTIME_ROOT}",
        "OpenCV_DIR": "$env{OpenCV_DIR}"
      }
    },
    {
      "name": "python-bindings",
      "displayName": "Python 3.12 development/QA binding with native runtime",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../.tools/native/build/presets/python-bindings",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CUAJONE_BUILD_RUNTIME": "ON",
        "CUAJONE_BUILD_TESTS": "ON",
        "CUAJONE_BUILD_PYTHON_BINDINGS": "ON",
        "CUAJONE_PYBIND11_ROOT": "$env{CUAJONE_PYBIND11_ROOT}",
        "CUAJONE_PYTHON_OUTPUT_DIR": "${sourceDir}/../.tools/native/build/presets/python-bindings/python",
        "Python_EXECUTABLE": "$env{CUAJONE_PYTHON_EXECUTABLE}",
        "TENSORRT_ROOT": "$env{TENSORRT_ROOT}",
        "ONNXRUNTIME_ROOT": "$env{ONNXRUNTIME_ROOT}",
        "CUDA_RUNTIME_ROOT": "$env{CUDA_RUNTIME_ROOT}",
        "CUDA_COMPILER_HEADERS_ROOT": "$env{CUDA_COMPILER_HEADERS_ROOT}",
        "CUDA_CCCL_HEADERS_ROOT": "$env{CUDA_CCCL_HEADERS_ROOT}",
        "OpenCV_DIR": "$env{OpenCV_DIR}"
      }
    },
    {
      "name": "gpu-onnx-integration",
      "displayName": "Real ONNX Runtime CUDA integration test",
      "inherits": "windows-msvc",
      "binaryDir": "${sourceDir}/../.tools/native/build/presets/gpu-onnx-integration",
      "cacheVariables": {
        "CUAJONE_BUILD_TESTS": "ON",
        "CUAJONE_ENABLE_TENSORRT": "OFF",
        "CUAJONE_ENABLE_ONNX_CUDA_INTEGRATION_TESTS": "ON",
        "CUAJONE_ENABLE_INTERNAL_DIAGNOSTICS": "ON",
        "ONNXRUNTIME_ROOT": "${sourceDir}/../.tools/native/onnxruntime-win-x64-gpu-1.25.0",
        "CUAJONE_ONNX_CUDA_DEPENDENCY_ROOTS": "${sourceDir}/../.tools/native/onnxruntime-win-x64-gpu-1.25.0/lib;${sourceDir}/../.tools/native/cuda-runtime/nvidia/cuda_runtime/bin;${sourceDir}/../.tools/native/nvidia-libraries/cublas/nvidia/cublas/bin;${sourceDir}/../.tools/native/nvidia-libraries/cudnn/nvidia/cudnn/bin;${sourceDir}/../.tools/native/nvidia-libraries/cufft/nvidia/cufft/bin;${sourceDir}/../.tools/native/vs/VC/Redist/MSVC/14.44.35112/x64/Microsoft.VC143.CRT",
        "CUAJONE_ONNX_CUDA_PPE_MODEL": "${sourceDir}/../.tools/native/build/presets/windows-msvc/models/ppe.onnx",
        "CUAJONE_ONNX_CUDA_POSE_MODEL": "${sourceDir}/../.tools/native/build/presets/windows-msvc/models/pose.onnx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc"
    },
    {
      "name": "cpu-tests-release",
      "configurePreset": "cpu-tests"
    },
    {
      "name": "python-bindings-release",
      "configurePreset": "python-bindings"
    },
    {
      "name": "gpu-onnx-integration-release",
      "configurePreset": "gpu-onnx-integration",
      "targets": ["cuajone_onnx_cuda_integration_tests"]
    }
  ],
  "testPresets": [
    {
      "name": "cpu-tests-release",
      "configurePreset": "cpu-tests",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "python-bindings-release",
      "configurePreset": "python-bindings",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "gpu-onnx-integration-release",
      "configurePreset": "gpu-onnx-integration",
      "filter": {
        "include": {
          "name": "^cuajone_onnx_(pose_cpu_standalone|cuda_ppe_only|cuda_hybrid_pipeline)_tests$"
        }
      },
      "output": { "outputOnFailure": true }
    }
  ]
}
