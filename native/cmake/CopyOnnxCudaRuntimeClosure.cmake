foreach(required DESTINATION_DIR DUMPBIN SEEDS SEARCH_ROOTS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required for the ONNX CUDA runtime closure")
    endif()
endforeach()

file(MAKE_DIRECTORY "${DESTINATION_DIR}")

function(assert_x64_pe path)
    execute_process(
        COMMAND "${DUMPBIN}" /headers "${path}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "8664 machine \\(x64\\)")
        message(FATAL_ERROR "Expected an x64 PE file: ${path}\n${output}${error}")
    endif()
endfunction()

function(read_dependencies path output)
    execute_process(
        COMMAND "${DUMPBIN}" /dependents "${path}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE text
        ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "dumpbin /dependents failed for ${path}\n${text}${error}")
    endif()
    string(REPLACE "\r\n" "\n" text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(dependencies)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" line)
        if(line MATCHES "^[A-Za-z0-9_.+-]+\\.dll$")
            string(TOLOWER "${line}" dependency)
            list(APPEND dependencies "${dependency}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES dependencies)
    set(${output} "${dependencies}" PARENT_SCOPE)
endfunction()

function(is_windows_external name output)
    if(name MATCHES "^(api-ms-|ext-ms-)")
        set(${output} TRUE PARENT_SCOPE)
        return()
    endif()
    set(system_dll "$ENV{SystemRoot}/System32/${name}")
    if(EXISTS "${system_dll}")
        set(${output} TRUE PARENT_SCOPE)
    else()
        set(${output} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(resolve_dependency name output)
    set(matches)
    foreach(root IN LISTS SEARCH_ROOTS)
        if(NOT IS_DIRECTORY "${root}")
            message(FATAL_ERROR "Trusted CUDA dependency root does not exist: ${root}")
        endif()
        file(GLOB candidates LIST_DIRECTORIES FALSE "${root}/${name}" "${root}/*/${name}")
        foreach(candidate IN LISTS candidates)
            get_filename_component(candidate_name "${candidate}" NAME)
            string(TOLOWER "${candidate_name}" candidate_name)
            if(candidate_name STREQUAL name)
                file(REAL_PATH "${candidate}" candidate)
                list(APPEND matches "${candidate}")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES matches)
    list(LENGTH matches count)
    if(count EQUAL 0)
        set(${output} "" PARENT_SCOPE)
    elseif(count EQUAL 1)
        set(${output} "${matches}" PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Ambiguous CUDA runtime dependency ${name}: ${matches}")
    endif()
endfunction()

# cuDNN 9 loads its component DLLs dynamically rather than expressing them as PE
# imports. Include the complete component set from the trusted roots before the
# normal PE graph walk so cudnnCreate can resolve without PATH fallbacks.
set(pending "${SEEDS}")
foreach(root IN LISTS SEARCH_ROOTS)
    file(GLOB cudnn_components LIST_DIRECTORIES FALSE "${root}/cudnn*.dll")
    list(APPEND pending ${cudnn_components})
endforeach()
set(resolved)
while(pending)
    list(POP_FRONT pending current)
    file(REAL_PATH "${current}" current)
    if(NOT EXISTS "${current}")
        message(FATAL_ERROR "Required ONNX CUDA runtime seed is missing: ${current}")
    endif()
    list(FIND resolved "${current}" already_resolved)
    if(NOT already_resolved EQUAL -1)
        continue()
    endif()
    assert_x64_pe("${current}")
    list(APPEND resolved "${current}")
    read_dependencies("${current}" dependencies)
    foreach(dependency IN LISTS dependencies)
        is_windows_external("${dependency}" external)
        if(external)
            continue()
        endif()
        resolve_dependency("${dependency}" dependency_path)
        if(dependency_path STREQUAL "")
            message(FATAL_ERROR "Unresolved non-system CUDA runtime dependency ${dependency} required by ${current}")
        endif()
        list(APPEND pending "${dependency_path}")
    endforeach()
endwhile()

foreach(path IN LISTS resolved)
    get_filename_component(name "${path}" NAME)
    set(destination "${DESTINATION_DIR}/${name}")
    if(EXISTS "${destination}")
        file(SHA256 "${path}" source_hash)
        file(SHA256 "${destination}" destination_hash)
        if(NOT source_hash STREQUAL destination_hash)
            message(FATAL_ERROR "Refusing to replace conflicting CUDA runtime DLL: ${destination}")
        endif()
    else()
        file(COPY_FILE "${path}" "${destination}" ONLY_IF_DIFFERENT)
    endif()
endforeach()

list(LENGTH resolved closure_count)
message(STATUS "Copied verified local ONNX CUDA runtime closure (${closure_count} DLLs) to ${DESTINATION_DIR}")
